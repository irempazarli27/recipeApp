# Veritabanı bağlantısı (Render PostgreSQL URL'ini buraya yaz)
DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT imzalama anahtarı (güçlü rastgele bir string)
JWT_SECRET=buraya-guclu-bir-secret-yaz

# Google Gemini API anahtarı
GEMINI_API_KEY=your-gemini-api-key

# Frontend URL'i (CORS için) - Netlify URL'ini yaz
FRONTEND_URL=https://your-app.netlify.app
